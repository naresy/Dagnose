  "dag_source": "\"\"\"Broken DAG: timeout. Task runs longer than its execution_timeout.\"\"\"\n\nimport time\nfrom datetime import datetime, timedelta\n\ntry:\n    from airflow.sdk import dag, task\nexcept ImportError:  # Airflow 2.x\n    from airflow.decorators import dag, task\n\n\n@dag(\n    dag_id=\"broken_task_timeout\",\n    schedule=None,\n    start_date=datetime(2026, 1, 1),\n    catchup=False,\n    tags=[\"broken\", \"timeout\"],\n    default_args={\"retries\": 0},\n)\ndef broken_task_timeout():\n    @task(execution_timeout=timedelta(seconds=10))\n    def slow_api_export() -> None:\n        for page in range(1, 100):\n            print(f\"Fetching page {page} from partner API ...\")\n            time.sleep(3)\n\n    slow_api_export()\n\n\nbroken_task_timeout()\n",
